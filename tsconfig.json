{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@luma/bridge": ["./packages/bridge/src/index.ts"],
      "@luma/bridge/types": ["./packages/bridge/src/types.ts"],
      "@luma/bridge/catalog": ["./packages/bridge/src/catalog.ts"]
    }
  },
  "include": ["src", "tests", "packages", "playwright.config.ts", "vite.config.ts"]
}
