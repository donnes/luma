<?xml version="1.0" encoding="utf-8"?>
<!-- Only window changes of Amazon's launcher reach HomeGuard; window content
     is read there to find and click the pinned Luma tile. Key events are
     filtered for the Menu key alone, which opens the agents inbox unless the
     active window is Luma's own page. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.amazon.tv.launcher"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/home_guard_description" />
