<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.luma.launcher"
    android:versionCode="1"
    android:versionName="1.0.1">

  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Luma's activity and its HomeGuard process talk over broadcasts only this app may send. -->
  <permission
      android:name="com.luma.launcher.permission.HOME_GUARD"
      android:protectionLevel="signature" />
  <uses-permission android:name="com.luma.launcher.permission.HOME_GUARD" />

  <!-- Luma is TV-first; keep the build side-loadable on handhelds too. -->
  <uses-feature android:name="android.software.leanback" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

  <!-- Cleartext is for T3 Code servers on the LAN and Tailscale, which serve plain HTTP. -->
  <application
      android:label="Luma"
      android:icon="@drawable/ic_launcher"
      android:banner="@drawable/ic_banner"
      android:allowBackup="false"
      android:hardwareAccelerated="true"
      android:usesCleartextTraffic="true"
      android:theme="@android:style/Theme.Material.NoActionBar">
    <activity
        android:name="app.luma.firetv.MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:screenOrientation="landscape"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <!-- Same filter serves phones, tablets, Fire TV sticks and Android TV. -->
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- POC: T3 Code's own web client, opened from the T3 Code tile. -->
    <activity
        android:name="app.luma.firetv.WebAppActivity"
        android:exported="false"
        android:screenOrientation="landscape"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />
    <!-- Returns to Luma whenever Fire OS shows Amazon's home screen. Its own
         process survives the low-memory killer taking down the WebView. -->
    <service
        android:name="app.luma.firetv.HomeGuard"
        android:process=":guard"
        android:label="Luma home"
        android:exported="true"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/home_guard" />
    </service>
  </application>
</manifest>
